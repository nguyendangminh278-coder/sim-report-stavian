rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/privateSettings/gemini {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'geminiApiKey',
          'model',
          'updatedAt'
        ])
        && request.resource.data.geminiApiKey is string
        && request.resource.data.geminiApiKey.size() >= 20
        && request.resource.data.geminiApiKey.size() <= 200
        && request.resource.data.model is string
        && request.resource.data.model.size() >= 1
        && request.resource.data.model.size() <= 120
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
